MONGODB_URI=mongodb://localhost:27017/havstrategy
API_KEY=change-me            # Claude Code sends this as "Authorization: Bearer <API_KEY>"
IG_DAILY_CAP=75
EMAIL_DAILY_CAP=100          # Gmail free ~500/day; stay well under for cold outreach
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=          # Google account > Security > App passwords
# TEST MODE: when set, DMs/emails are delivered ONLY to these. Remove to go live.
IG_ALLOWLIST=_akshitmahajan
# Shortlists are approved automatically when the client has a saved message (dmTemplate). Set to off to approve by hand on the Campaigns page.
AUTO_APPROVE=on
EMAIL_ALLOWLIST=none
# Client review sheets: Google Cloud service account JSON key on ONE line (enable the Sheets API and the Drive API on its project)
GOOGLE_SA_JSON=

# --- Access Hub (/access) -------------------------------------------------------------------------------
# APP_MODE=demo (default): embedded Postgres in .data/, simulated Meta/Google OAuth. APP_MODE=production: real Postgres + real OAuth (needed on Vercel).
APP_MODE=demo
# DATABASE_URL=postgres://...            # production only; then run: npm run access:migrate
# SESSION_SECRET=                         # production: openssl rand -base64 48 (signs the OAuth state)
# TOKEN_ENCRYPTION_KEY_REFERENCE=         # production: openssl rand -base64 32 (encrypts stored OAuth tokens)
# CRON_SECRET=                            # bearer token for /api/access/cron/*
# META_APP_ID= META_APP_SECRET= GOOGLE_CLIENT_ID= GOOGLE_CLIENT_SECRET= GOOGLE_ADS_DEVELOPER_TOKEN=   (see havstrategy-access-hub/.env.example for the rest)
# ACCESS_DEMO_DATA=on                     # demo mode only: seed 5 fake sample clients
