MONGODB_URI=mongodb://localhost:27017/havstrategy
API_KEY=change-me            # Claude Code sends this as "Authorization: Bearer <API_KEY>"
IG_DAILY_CAP=75
EMAIL_DAILY_CAP=100          # Gmail free ~500/day; stay well under for cold outreach
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=          # Google account > Security > App passwords
# TEST MODE: when set, DMs/emails are delivered ONLY to these. Remove to go live.
IG_ALLOWLIST=_akshitmahajan
# Shortlists are approved automatically when the client has a saved message (dmTemplate). Set to off to approve by hand on the Campaigns page.
AUTO_APPROVE=on
EMAIL_ALLOWLIST=none
# Client review sheets, the onboarding form's live sheet, and the guidelines Terms-PDF merge: Google Cloud service account JSON
# key on ONE line (enable the Sheets API, the Drive API AND the Docs API on its project). Share each destination sheet/doc
# with its client_email as Editor.
GOOGLE_SA_JSON=
# Onboarding form fallback only; normally set the sheet link on the dashboard's Settings page instead.
ONBOARDING_SHEET_ID=
ONBOARDING_SHEET_TAB=Onboarding
# Onboarding form -> a condensed brief page in Notion. An integration's secret from notion.so/my-integrations (share the
# destination page with it: "..." menu > Connections). NOTION_PARENT_PAGE_ID is a fallback; normally set the page link on
# the dashboard's Settings page instead.
NOTION_API_KEY=
NOTION_PARENT_PAGE_ID=
# Social dashboard: encrypts stored Metricool/Meta tokens (falls back to API_KEY)
SECRETS_KEY=
# Instagram chat bots (Meta "Unified login"): see the notice on the Organizations page for the redirect and webhook URLs
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=             # the login configuration's id (App Dashboard > Instagram > API setup with Unified login)
META_VERIFY_TOKEN=          # any string; paste the same one into the app's webhook settings
# The Meta login configuration must include instagram_business_basic, instagram_business_manage_messages and instagram_business_manage_insights
# (Meta renamed these from instagram_basic / instagram_manage_messages / instagram_manage_insights; use whichever names your app's permissions list shows)
